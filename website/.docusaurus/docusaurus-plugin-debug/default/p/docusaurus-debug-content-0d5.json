{"allContent":{"docusaurus-plugin-content-docs":{"default":{"loadedVersions":[{"versionName":"current","label":"Next","banner":null,"badge":false,"noIndex":false,"className":"docs-version-current","path":"/","tagsPath":"/tags","editUrl":"https://github.com/ONEARMY/project-kamp-academy/blob/master/../docs","isLast":true,"routePriority":-1,"sidebarFilePath":"/Users/dave/Documents/GitHub/project-kamp-academy/website/sidebars.js","contentPath":"/Users/dave/Documents/GitHub/project-kamp-academy/docs","docs":[{"id":"basekamp/container","title":"Work in a container","description":"Big update coming to the Academy April 2027. Stay tuned 🔥","source":"@site/../docs/basekamp/container.md","sourceDirName":"basekamp","slug":"/basekamp/container","permalink":"/basekamp/container","draft":false,"unlisted":false,"editUrl":"https://github.com/ONEARMY/project-kamp-academy/blob/master/../docs/basekamp/container.md","tags":[],"version":"current","frontMatter":{"id":"container","title":"Work in a container"},"sidebar":"docs","previous":{"title":"House in a Van","permalink":"/basekamp/house"},"next":{"title":"Latest update","permalink":"/updates/"}},{"id":"basekamp/house","title":"House in a Van","description":"Big update coming to the Academy April 2027. Stay tuned 🔥","source":"@site/../docs/basekamp/house.md","sourceDirName":"basekamp","slug":"/basekamp/house","permalink":"/basekamp/house","draft":false,"unlisted":false,"editUrl":"https://github.com/ONEARMY/project-kamp-academy/blob/master/../docs/basekamp/house.md","tags":[],"version":"current","frontMatter":{"id":"house","title":"House in a Van"},"sidebar":"docs","previous":{"title":"Introduction","permalink":"/basekamp/intro"},"next":{"title":"Work in a container","permalink":"/basekamp/container"}},{"id":"basekamp/intro","title":"Introduction","description":"In the early days there is not much on the land, no infrastructure, no kitchen, no shower, no house etc. It's hard to get something going without tools, food and a good sleep. 